# Production settings for docker-compose.production.yml.
# Copy to .env.prod and fill in every value. Never commit .env.prod.

# Public domain, e.g. referee.example.ch. Caddy gets the HTTPS certificate
# for it, and Django only accepts requests for it.
DOMAIN=

# Long random string, e.g. from:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# RSA private key (PEM) that signs the login tokens (RS256). Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# Put it on one line with the line breaks written as \n. Changing it logs
# everyone out.
JWT_PRIVATE_KEY=

# Keys that encrypt the secrets of authenticator apps and recovery codes,
# comma-separated, newest first. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate, put a new key first and keep the old ones. Losing every key
# makes all authenticator apps and recovery codes unusable.
MFA_ENCRYPTION_KEYS=

# Optional. Domain passkeys are bound to; defaults to DOMAIN. Changing it
# later invalidates every registered passkey.
# WEBAUTHN_RP_ID=

# Database container. Django uses the same values to connect.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Outgoing mail over SMTP, e.g. smtp+tls://user:password@smtp.example.ch:587
# (smtp+ssl:// for port 465). URL-encode special characters in the password.
EMAIL=
# Sender address, e.g. Referee System <noreply@example.ch>
DEFAULT_FROM_EMAIL=

# Flower login as user:password. Only used with --profile flower.
FLOWER_BASIC_AUTH=
