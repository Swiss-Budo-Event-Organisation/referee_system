# Optional settings for running the backend outside Docker with the local
# settings. Copy to backend/.env and uncomment what you need. The containers
# set these themselves, and the tests need none of them. Production uses
# .env.prod in the repository root instead.

# Database. If unset, POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD,
# POSTGRES_HOST and POSTGRES_PORT are used.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Outgoing mail as a URL. Default: printed to the console.
# EMAIL=consolemail://

# Celery broker. Default: redis://redis:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0

# Default: a fixed development key.
# SECRET_KEY=
